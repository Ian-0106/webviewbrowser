{
  "name": "webview-browser-electron",
  "version": "1.3.1",
  "description": "Electron implementation of the WebView Browser sample",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:security": "electron verification/security-smoke.cjs",
    "check": "node --check main.js && node --check preload.js && node --check activity-preload.js && node --check renderer/renderer.js && node --check renderer/activity.js && node --test",
    "build:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.webviewbrowser.electron",
    "productName": "WebView Browser Electron",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "activity-preload.js",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "WebView Browser Electron",
      "include": "build/installer.nsh",
      "artifactName": "WebView-Browser-Electron-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "WebView-Browser-Electron-${version}-portable.${ext}"
    }
  }
}
